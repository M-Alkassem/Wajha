{
  "format": "wajha.template",
  "version": 1,
  "id": "terminal",
  "name": "Terminal",
  "author": "Wajha Community",
  "description": "A developer tool after midnight: near-black with a phosphor-green grid, prompt-style eyebrows, Space Grotesk headlines and bare screenshots glowing in the dark.",
  "category": "dark",
  "tags": [
    "developer",
    "green",
    "grid",
    "dark",
    "code"
  ],
  "theme": {
    "background": {
      "fill": {
        "type": "radial",
        "cx": 0.5,
        "cy": 0.15,
        "radius": 0.95,
        "stops": [
          {
            "offset": 0,
            "color": "#0d2216"
          },
          {
            "offset": 0.6,
            "color": "#07110b"
          },
          {
            "offset": 1,
            "color": "#040805"
          }
        ]
      },
      "pattern": {
        "kind": "grid",
        "color": "#39ff88",
        "opacity": 0.07,
        "scale": 0.06
      }
    },
    "panorama": false,
    "fonts": {
      "heading": "Space Grotesk Variable",
      "body": "Inter Variable"
    },
    "palette": [
      "#2bd97a",
      "#00c2ff",
      "#ffcc33",
      "#ff5c7a",
      "#eafff2",
      "#040805"
    ],
    "mockDark": true
  },
  "slides": [
    {
      "texts": {
        "en-US": {
          "eyebrow": "$ ship --prod",
          "headline": "Deploy from *anywhere*",
          "subtitle": "Push, preview and roll back from your phone."
        },
        "ar-SA": {
          "eyebrow": "$ ship --prod",
          "headline": "انشر من *أي مكان*",
          "subtitle": "ادفع التحديثات وعاينها وتراجع عنها من هاتفك."
        }
      },
      "layouts": {
        "tall": {
          "background": null,
          "elements": [
            {
              "id": "glow-1",
              "kind": "shape",
              "x": 0.5,
              "y": 0.66,
              "rotation": 0,
              "opacity": 0.22,
              "shape": "circle",
              "width": 0.9,
              "height": 0.9,
              "fill": {
                "type": "solid",
                "color": "#39ff88"
              },
              "radius": 0,
              "stroke": 0,
              "blur": 0.14,
              "seed": 0
            },
            {
              "id": "device",
              "kind": "device",
              "x": 0.5,
              "y": 0.67,
              "rotation": 0,
              "opacity": 1,
              "frame": "none",
              "style": {
                "color": "#2b2c31",
                "finish": "metal",
                "bezel": "black"
              },
              "width": 0.74,
              "slot": "main",
              "cornerRadius": 0.06,
              "shadow": {
                "color": "#000000cc",
                "blur": 0.07,
                "x": 0,
                "y": 0.03
              }
            },
            {
              "id": "eyebrow",
              "kind": "text",
              "x": 0.5,
              "y": 0.05,
              "rotation": 0,
              "opacity": 1,
              "key": "eyebrow",
              "width": 0.8,
              "valign": "top",
              "style": {
                "font": "Space Grotesk Variable",
                "weight": 500,
                "size": 0.034,
                "lineHeight": 1.2,
                "letterSpacing": 0.02,
                "color": "#39ff88",
                "highlight": "#eafff2",
                "highlightMode": "color",
                "align": "center",
                "transform": "none",
                "maxLines": 1,
                "shadow": null
              }
            },
            {
              "id": "headline",
              "kind": "text",
