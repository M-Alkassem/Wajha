{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Wajha",
  "version": "0.1.1",
  "identifier": "studio.wajha.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wajha",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "preventOverflow": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 26 },
        "acceptFirstMouse": true,
        "allowLinkPreview": false,
        "backgroundThrottling": "disabled",
        "dragDropEnabled": false,
        "backgroundColor": "#0c0c10"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://cdn.jsdelivr.net blob: data:",
        "img-src": "'self' blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Beautiful App Store and Google Play screenshots",
    "longDescription": "Wajha is a free, open-source, offline app for designing App Store and Google Play screenshots with device frames, templates and translations.",
    "copyright": "Copyright © 2026 Wajha contributors. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
